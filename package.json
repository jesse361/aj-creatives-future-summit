{
  "name": "why-us-events",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-postgres.mjs && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/ensure-postgres.mjs && prisma migrate deploy",
    "db:seed": "node scripts/ensure-postgres.mjs && tsx prisma/seed.ts",
    "db:setup": "node scripts/ensure-postgres.mjs && prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@vercel/blob": "^2.2.0",
    "lucide-react": "^0.546.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.66.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "embedded-postgres@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "unrs-resolver@1.12.2": true
  }
}
