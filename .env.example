# Copy this file to .env. Values below are local placeholders, not production secrets.

# SQLite file used because PostgreSQL is not installed in this environment.
# For PostgreSQL, change prisma/schema.prisma provider to "postgresql"
# and set a connection string such as:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/future_summit"
DATABASE_URL="file:./dev.db"

# Required. Use a long random string. Never expose this to the browser.
AUTH_SECRET="replace-with-a-long-random-string"

# Local administrator. This is not the public event contact address.
ADMIN_EMAIL="organizer@example.com"
ADMIN_PASSWORD="replace-with-a-private-password"

# Used for absolute links, metadata, and payment return URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Registration and inquiry email is skipped until both are set.
# RESEND_API_KEY=""
# EMAIL_FROM="AJ Creatives <events@your-domain.com>"

# Optional. Paid tickets stay unpaid requests until both Stripe values are set
# and the webhook signature verifies a successful payment.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
