# Copy to .env and replace every value before a public deployment.

# SQLite file, resolved relative to the prisma folder.
# For PostgreSQL, change the provider in prisma/schema.prisma and use a
# connection string such as postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="file:./dev.db"

# Long random string used to hash visitor addresses for rate limits.
AUTH_SECRET="replace-with-a-random-string-at-least-32-characters"

# Local administrator. This is not the public event contact address.
ADMIN_EMAIL="organizer@example.com"
ADMIN_PASSWORD="change-this-password"

# Used for canonical links, sitemap, and payment return URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Paid tickets stay unpaid requests until these are set and the
# webhook verifies payment. Never put the secret key in client code.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional confirmation email. Registration still succeeds when these are empty.
RESEND_API_KEY=""
EMAIL_FROM=""
