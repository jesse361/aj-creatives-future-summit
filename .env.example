# Copy to .env. Never commit the real file.

# Pooled connection for the app, and a direct connection for Prisma migrations.
# Local development can use the same value for both. Hosted Neon should use the
# pooled URL for DATABASE_URL and the non-pooled URL for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Long random string. Used to hash visitor addresses for rate limits.
AUTH_SECRET="replace-with-a-random-string-at-least-32-characters"

# First administrator. Used only by `npm run db:seed` when no admin exists.
# Password must be at least 12 characters and must not be a published example.
ADMIN_NAME="Owner"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Public site URL. APP_URL is preferred for server callbacks. NEXT_PUBLIC_SITE_URL
# is the same public origin used for metadata. Neither value is a secret.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Paystack. Leave blank until the merchant account is ready. Paid checkout
# stays unavailable and is labeled as such. Never put the secret in client code.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Transactional email. Registration still succeeds when these are empty.
RESEND_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""
RESEND_AUDIENCE_ID=""

# Vercel Blob. Uploads are refused until this token exists.
BLOB_READ_WRITE_TOKEN=""

# Protects the hold-release cron route.
CRON_SECRET=""
